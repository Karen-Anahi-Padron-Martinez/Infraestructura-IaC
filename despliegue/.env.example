# Copia este archivo como .env y define valores propios. El archivo .env NUNCA se sube a Git.
DB_ROOT_PASSWORD=cambia-esta-contrasena
DB_USER=gestor
DB_PASSWORD=cambia-esta-contrasena

# Etiquetas de las imágenes (Jenkins publica latest y el número de build)
API_TAG=latest
CLIENTE_TAG=latest

# Puerto público del cliente web y URL con la que se accede (para CORS de la API)
CLIENTE_PUERTO=8082
CLIENTE_URL=http://localhost:8082

# Carpeta con los scripts SQL de Microservicio-BD (relativa a este archivo)
BD_SQL_DIR=../../Microservicio-BD/sql

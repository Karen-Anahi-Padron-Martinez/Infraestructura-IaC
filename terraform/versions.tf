terraform {
  required_version = ">= 1.6.0"

  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "~> 4.0"
    }
    local = {
      source  = "hashicorp/local"
      version = "~> 2.5"
    }
  }
}

provider "azurerm" {
  features {}
  # La suscripción se toma de terraform.tfvars (no versionado) o de la variable de entorno ARM_SUBSCRIPTION_ID
  subscription_id = var.subscription_id
}
